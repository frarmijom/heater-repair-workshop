meta {
  name: Complete work order
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/work-orders/{{orderId}}/complete
  body: none
  auth: none
}

tests {
  test("returns a completed order", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("COMPLETED");
  });
}

headers {
  X-CSRF-TOKEN: {{csrfToken}}
}
